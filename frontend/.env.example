# Copiar a .env.local (gitignored). NO usar backend/.env — Vite solo lee este archivo.
# cp .env.example .env.local

# API backend — en dev usar /api (proxy Vite → :8000, evita CORS con IP de red)
VITE_API_URL=/api

# Auth opcional (Supabase) — mismos valores que SUPABASE_URL / SUPABASE_KEY en backend/.env
# Sin estas vars la app anónima (wizard, resultados, vacantes) sigue funcionando
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# GitHub Pages: VITE_BASE_PATH=/DulIa/
# Vercel: dejar vacío o /

# Forzar datos mock en Mi Progreso / entrevista (sin llamar al backend)
# VITE_FORCE_PROGRESS_MOCK=true

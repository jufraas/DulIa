# Copiar a .env.local (gitignored). NO usar backend/.env — Vite solo lee este archivo.
# cp .env.example .env.local

# API backend (desarrollo local)
VITE_API_URL=http://localhost:8000/api

# Auth Supabase (login Google) — mismos valores que SUPABASE_URL / SUPABASE_KEY en backend/.env
# Sin estas vars la app anónima (wizard, resultados) sigue funcionando
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# GitHub Pages: VITE_BASE_PATH=/DulIa/
# Vercel: dejar vacío o /

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
# Legacy (retrocompat): SUPABASE_KEY=tu-anon-key-aqui

# Google Gemini
GEMINI_API_KEY=tu-gemini-api-key-aqui
# Modelo por defecto (cv parse, profile, coach, analyze)
GEMINI_MODEL=gemini-3.1-flash-lite

# Adzuna — https://developer.adzuna.com (registrar app, obtener App ID + App Key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — https://jooble.org/api/about (solicitar API key por email)
JOOBLE_API_KEY=

# App
APP_ENV=development
USE_MOCK_DATA=false

# Supabase — aplicar migraciones en SQL Editor antes de modo real:
#   backend/migrations/002_plan2_tables.sql
#   backend/migrations/004_plan2_backend_fixes.sql
#   backend/migrations/008_user_interests.sql
#   backend/migrations/009_scrape_queue.sql
#   backend/migrations/010_user_accounts.sql
#   backend/migrations/011_profiles_user_link.sql
#   backend/migrations/012_progress_and_interviews.sql
#   backend/migrations/013_seed_interview_questions.sql

# CORS — en producción lista explícita del frontend (separada por comas)
# CORS_ORIGINS=https://dulia.vercel.app,http://localhost:5173

# Rate limit en endpoints Gemini (POST /profile, POST /coach/chat)
RATE_LIMIT_GEMINI=10/minute

# Jobs cache-first (GET /jobs/recommended)
FRESH_HORIZON_HOURS=48
MIN_FRESH_JOBS=10
RECOMMENDED_TOP_N=0
